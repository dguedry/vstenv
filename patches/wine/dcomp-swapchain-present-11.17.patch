+    data.width = width;
+    data.height = height;
+    data.blit_count = 0;
+
+    EnumWindows(surface_blit_enum_proc, (LPARAM)&data);
+
+    if (data.blit_count)
+        TRACE("Blit DXGI surface %ux%u to %u popup window(s).\n",
+                width, height, data.blit_count);
+}
