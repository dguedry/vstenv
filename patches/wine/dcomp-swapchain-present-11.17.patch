+    memcpy( font->lfFaceName, info->Data, size );
+    memset( (char *)font->lfFaceName + size, 0, sizeof(font->lfFaceName) - size );
+    TRACE( "Using %s for DEFAULT_GUI_FONT.\n", debugstr_w(font->lfFaceName) );
+}
