+
+static BOOL copy_ancestor_frame(const struct composition_target *parent, POINT pt, HDC dst, int w, int h)
+{
+    HBITMAP old;
+    HDC src;
+
+    if (!(src = CreateCompatibleDC(dst))) return FALSE;
+    old = SelectObject(src, parent->back_bitmap);
+    BitBlt(dst, 0, 0, w, h, src, pt.x, pt.y, SRCCOPY);
+    SelectObject(src, old);
+    DeleteDC(src);
+    return TRUE;
+}
+
+/* How many visuals of a tree draw something, counted up to limit. */
+static unsigned int count_drawing_visuals(struct composition_visual *visual, unsigned int limit)
+{
+    struct composition_visual *child;
+    unsigned int count = visual->content ? 1 : 0;
+
+    if (visual->shared_visual_handle)
+    {
+        struct composition_visual *root = shared_visual_target_get_root(visual->shared_visual_handle);
+        if (root) count += count_drawing_visuals(root, limit);
+    }
+    LIST_FOR_EACH_ENTRY(child, &visual->child_visuals, struct composition_visual, entry)
+    {
+        if (count >= limit) break;
+        count += count_drawing_visuals(child, limit - count);
     }
-    return FALSE;
+    return count;
 }
 
