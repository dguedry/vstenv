 /* property to store IDropTarget pointer */
 static const WCHAR prop_oledroptarget[] = L"OleDropTargetInterface";
+/* Wine-private authoritative copy of the registered drop target. The public
+ * "OleDropTargetInterface" prop exists only for compatibility with Windows,
+ * where it is not what RevokeDragDrop consumes; WebView2's embedded browser is
+ * known to poke it and to free its target before revoking, so it cannot be
+ * trusted for the paired Release. */
+static const WCHAR prop_winedroptarget[] = L"WineOleDropTargetInterface";
 
 /* property to store Marshalled IDropTarget pointer */
 static const WCHAR prop_marshalleddroptarget[] = L"WineMarshalledDropTarget";
@@ -418,7 +425,8 @@
 static inline HRESULT get_target_from_wrapper( IDropTarget *wrapper, IDropTarget **target )
 {
     DropTargetWrapper* This = impl_from_IDropTarget( wrapper );
-    *target = GetPropW( This->hwnd, prop_oledroptarget );
+    *target = GetPropW( This->hwnd, prop_winedroptarget );
+    if (!*target) *target = GetPropW( This->hwnd, prop_oledroptarget );
     if (!*target) return DRAGDROP_E_NOTREGISTERED;
     IDropTarget_AddRef( *target );
     return S_OK;
@@ -607,6 +615,7 @@
     {
       IDropTarget_AddRef(pDropTarget);
       SetPropW(hwnd, prop_oledroptarget, pDropTarget);
+      SetPropW(hwnd, prop_winedroptarget, pDropTarget);
