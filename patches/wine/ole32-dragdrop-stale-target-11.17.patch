   RemovePropW(hwnd, prop_oledroptarget);
+  RemovePropW(hwnd, prop_winedroptarget);
   RemovePropW(hwnd, prop_marshalleddroptarget);
 
+  if (drop_target)
+  {
+      /* The paired Release for RegisterDragDrop's AddRef. The object can already
+       * be gone: WebView2's embedded browser registers its own target, frees its
