+static HRESULT create_virtual_surface_from_device(struct composition_device *device, UINT width, UINT height,
+        DXGI_FORMAT pixel_format, DXGI_ALPHA_MODE alpha_mode, IDCompositionVirtualSurface **surface)
+{
+    IDCompositionSurfaceFactory *factory;
+    HRESULT hr;
+
+    if (!surface)
+        return E_INVALIDARG;
+    *surface = NULL;
+    if (!device->rendering_device)
+    {
+        FIXME("device created without a rendering device.\n");
+        return E_NOTIMPL;
+    }
+    if (FAILED(hr = create_surface_factory(device, device->rendering_device, &factory)))
+        return hr;
+    hr = IDCompositionSurfaceFactory_CreateVirtualSurface(factory, width, height, pixel_format, alpha_mode, surface);
+    IDCompositionSurfaceFactory_Release(factory);
