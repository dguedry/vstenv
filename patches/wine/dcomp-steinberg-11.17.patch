+/* IDCompositionVirtualSurface: an IDCompositionSurface that can be resized and trimmed. */
+static inline struct composition_surface *impl_from_IDCompositionVirtualSurface(IDCompositionVirtualSurface *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_surface, IDCompositionVirtualSurface_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE vsurface_QueryInterface(IDCompositionVirtualSurface *iface, REFIID iid, void **out)
+{
+    return surface_QueryInterface(&impl_from_IDCompositionVirtualSurface(iface)->IDCompositionSurfaceUnknown_iface, iid, out);
+}
+
+static ULONG STDMETHODCALLTYPE vsurface_AddRef(IDCompositionVirtualSurface *iface)
+{
+    return surface_AddRef(&impl_from_IDCompositionVirtualSurface(iface)->IDCompositionSurfaceUnknown_iface);
+}
+
+static ULONG STDMETHODCALLTYPE vsurface_Release(IDCompositionVirtualSurface *iface)
+{
+    return surface_Release(&impl_from_IDCompositionVirtualSurface(iface)->IDCompositionSurfaceUnknown_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE vsurface_BeginDraw(IDCompositionVirtualSurface *iface, const RECT *rect,
+        REFIID iid, void **object, POINT *offset)
+{
+    return surface_BeginDraw(&impl_from_IDCompositionVirtualSurface(iface)->IDCompositionSurfaceUnknown_iface, rect, iid, object, offset);
+}
+
+static HRESULT STDMETHODCALLTYPE vsurface_EndDraw(IDCompositionVirtualSurface *iface)
+{
+    return surface_EndDraw(&impl_from_IDCompositionVirtualSurface(iface)->IDCompositionSurfaceUnknown_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE vsurface_SuspendDraw(IDCompositionVirtualSurface *iface)
+{
+    return surface_SuspendDraw(&impl_from_IDCompositionVirtualSurface(iface)->IDCompositionSurfaceUnknown_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE vsurface_ResumeDraw(IDCompositionVirtualSurface *iface)
+{
+    return surface_ResumeDraw(&impl_from_IDCompositionVirtualSurface(iface)->IDCompositionSurfaceUnknown_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE vsurface_Scroll(IDCompositionVirtualSurface *iface, const RECT *scroll,
+        const RECT *clip, int offset_x, int offset_y)
+{
+    return surface_Scroll(&impl_from_IDCompositionVirtualSurface(iface)->IDCompositionSurfaceUnknown_iface, scroll, clip, offset_x, offset_y);
+}
+
+static HRESULT STDMETHODCALLTYPE vsurface_Resize(IDCompositionVirtualSurface *iface, UINT width, UINT height)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    struct composition_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(surface->factory);
+    IDXGISurface *dxgi_surface;
+    DXGI_SURFACE_DESC desc;
+    HRESULT hr;
+
+    TRACE("iface %p, width %u, height %u.\n", iface, width, height);
+
+    if (!width || !height)
+        return E_INVALIDARG;
+    if (width == surface->width && height == surface->height)
+        return S_OK;
+    if (!factory->dxgi_device)
+        return E_NOTIMPL;
+
+    /* A new backing surface of the new size; the content is not carried over. */
+    desc.Width = width;
+    desc.Height = height;
+    desc.Format = surface->pixel_format;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    if (FAILED(hr = IDXGIDevice_CreateSurface(factory->dxgi_device, &desc, 1,
+            DXGI_USAGE_BACK_BUFFER | DXGI_USAGE_SHADER_INPUT, NULL, &dxgi_surface)))
+    {
+        ERR("Failed to create a IDXGISurface, hr %#lx.\n", hr);
+        return hr;
+    }
+    IUnknown_Release(surface->physical_surface);
+    surface->physical_surface = (IUnknown *)dxgi_surface;
+    if (surface->draw_surface)
+    {
+        ID3D11Texture2D_Release(surface->draw_surface);
+        surface->draw_surface = NULL;
+    }
+    surface->width = width;
+    surface->height = height;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE vsurface_Trim(IDCompositionVirtualSurface *iface, const RECT *rectangles, UINT count)
+{
+    TRACE("iface %p, rectangles %p, count %u: nothing to reclaim.\n", iface, rectangles, count);
+    return S_OK;
+}
