--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -2156,6 +2156,29 @@
 }
 
 
+/* JUCE 8.0.13 and later ask GetProcAddress( ntdll, "wine_get_version" ) and take
+ * a fallback when it succeeds, under which a plugin (Minimal Audio's Squash)
+ * paints its sign-in panel empty.  WINE_HIDE_WINE_VERSION=1 hides that one export
+ * from a single process.  It stays off unless asked for: other code probes for
+ * Wine too and depends on the answer (PACE/iLok fails to start without it).
+ * Idea from github.com/giang17/wine (branches d2d1-dcomp-*). */
+static BOOL hide_wine_version_export(void)
+{
+    static int cached = -1;
+
+    if (cached == -1)
+    {
+        WCHAR buf[8];
+        SIZE_T len = 0;
+
+        buf[0] = 0;
+        cached = !RtlQueryEnvironmentVariable( NULL, L"WINE_HIDE_WINE_VERSION", 22,
+                                               buf, ARRAY_SIZE(buf) - 1, &len )
+                 && buf[0] && buf[0] != '0';
+    }
+    return cached;
+}
+
 /******************************************************************
  *		LdrGetProcedureAddress  (NTDLL.@)
  */
@@ -2167,6 +2190,11 @@
     DWORD exp_size;
     NTSTATUS ret = STATUS_PROCEDURE_NOT_FOUND;
 
+    if (name && name->Buffer && name->Length == 16
+        && !memcmp( name->Buffer, "wine_get_version", 16 )
+        && hide_wine_version_export())
+        return STATUS_PROCEDURE_NOT_FOUND;
+
     RtlEnterCriticalSection( &loader_section );
 
     /* check if the module itself is invalid to return the proper error */
