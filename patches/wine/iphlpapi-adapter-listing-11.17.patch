+/******************************************************************
+ *    DllMain (IPHLPAPI.@)
+ *
+ * Once loaded, stays loaded. A program that loads this library for each
+ * question it has and frees it again (a copy protection reading the adapters'
+ * addresses a few thousand times as its plugin starts) otherwise pays for
+ * loading it, nsi.dll and dnsapi.dll every time: most of what was left of
+ * the wait once the listing itself was cheap.
+ */
+BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( inst );
+        LdrAddRefDll( LDR_ADDREF_DLL_PIN, inst );
+    }
+    return TRUE;
+}
