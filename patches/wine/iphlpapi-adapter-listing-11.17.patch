+/* For a listing of every interface (under if_list_lock): one socket and one reading
+ * of /proc/net/dev for all of them. Each interface opened its own and read the whole
+ * file to find its one line, so a listing cost the square of the interface count. */
+static int listing_sock = -1;
+static char *listing_netdev;
+
+#ifdef __linux__
+static char *read_proc_net_dev( void )
+{
+    size_t size = 4096, len = 0, got;
+    char *buf = malloc( size ), *bigger;
+    FILE *fp;
+
+    if (!buf) return NULL;
+    if (!(fp = fopen( "/proc/net/dev", "r" )))
+    {
+        free( buf );
+        return NULL;
+    }
+    while ((got = fread( buf + len, 1, size - len - 1, fp )) > 0)
+    {
+        len += got;
+        if (len + 1 < size) continue;
+        if (!(bigger = realloc( buf, size * 2 ))) break;
+        buf = bigger;
+        size *= 2;
+    }
+    fclose( fp );
+    buf[len] = 0;
+    return buf;
+}
+
+static void netdev_line_to_dynamic( const char *ptr, struct nsi_ndis_ifinfo_dynamic *data )
+{
+    unsigned long long values[9];
+
+    if (sscanf( ptr, "%llu %llu %llu %llu %*u %*u %*u %llu %llu %llu %llu %llu",
+                values, values + 1, values + 2, values + 3, values + 4,
+                values + 5, values + 6, values + 7, values + 8 ) != 9) return;
+    data->in_octets      = values[0];
+    data->in_ucast_pkts  = values[1];
+    data->in_errors      = values[2];
+    data->in_discards    = values[3];
+    data->in_mcast_pkts  = values[4];
+    data->out_octets     = values[5];
+    data->out_ucast_pkts = values[6];
+    data->out_errors     = values[7];
+    data->out_discards   = values[8];
+    /* Some applications check for link speed >= 1000000 */
+    data->rcv_speed = data->xmit_speed = 1000000;
+}
+#endif
