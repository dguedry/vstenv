--- a/dlls/dxgi/output.c
+++ b/dlls/dxgi/output.c
@@ -363,14 +363,33 @@
 
 static HRESULT STDMETHODCALLTYPE dxgi_output_WaitForVBlank(IDXGIOutput6 *iface)
 {
-    static BOOL once = FALSE;
+    struct dxgi_output *output = impl_from_IDXGIOutput6(iface);
+    struct wined3d_display_mode mode;
+    ULONGLONG period_us, phase_us, wait_ms;
+    LARGE_INTEGER freq, now;
+    unsigned int refresh = 60;
 
-    if (!once++)
-        FIXME("iface %p stub!\n", iface);
-    else
-        TRACE("iface %p stub!\n", iface);
+    TRACE("iface %p.\n", iface);
 
-    return E_NOTIMPL;
+    wined3d_mutex_lock();
+    if (SUCCEEDED(wined3d_output_get_display_mode(output->wined3d_output, &mode, NULL)) && mode.refresh_rate)
+        refresh = mode.refresh_rate;
+    wined3d_mutex_unlock();
+
+    /* No vertical blank signal reaches us, so wait out the current refresh
+     * period instead (as DXVK does) and report success. Returning E_NOTIMPL
+     * here is worse than an approximate tick: JUCE 8's Direct2D window peer
+     * paces painting on this call, and its vblank thread only checks its exit
+     * flag after a successful wait, so on E_NOTIMPL it spins forever and the
+     * main thread hangs waiting for it (Spitfire Audio, and any JUCE 8 GUI). */
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&now);
+    period_us = 1000000 / refresh;
+    phase_us = (now.QuadPart * 1000000 / freq.QuadPart) % period_us;
+    wait_ms = (period_us - phase_us + 999) / 1000;
+    Sleep(wait_ms ? wait_ms : 1);
+
+    return S_OK;
 }
 
